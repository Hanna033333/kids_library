# 책자리 백엔드 환경변수 설정 가이드
# 이 파일을 복사하여 .env 파일을 생성하세요: cp .env.example .env

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase 프로젝트 URL (Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 서비스 롤 키 (Settings > API > service_role) - 서버사이드 전용, 절대 프론트엔드 노출 금지
# core/config.py는 SUPABASE_SERVICE_KEY(또는 SUPABASE_SERVICE_ROLE_KEY)를 SUPABASE_KEY보다 우선합니다.
# 서비스 롤 키는 RLS를 우회하므로, 반드시 서비스 롤 키를 넣어야 book_reviews INSERT 등 백엔드 쓰기 작업이 정상 동작합니다.
SUPABASE_KEY=your-service-role-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Threads API ──────────────────────────────────────────────────────────────
# Meta Threads 앱 액세스 토큰
THREADS_ACCESS_TOKEN=your-threads-access-token

# Threads 사용자 ID
THREADS_USER_ID=your-threads-user-id

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 텔레그램 관리자 채팅 ID
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Google Gemini API 키 (AI studio에서 발급)
GEMINI_API_KEY=your-gemini-api-key

# ─── 배포 설정 ────────────────────────────────────────────────────────────────
# 백엔드 서버 공개 URL (AWS Lightsail 운영 서버: https://api.checkjari.com)
# 로컬 테스트 시: http://lvh.me:8000 (localhost 대신 사용해야 텔레그램 인라인 버튼 URL이 허용됨)
BACKEND_URL=https://api.checkjari.com

# 환경 구분 — 반드시 명시적으로 설정할 것 (화이트리스트 방식, fail-closed).
# ENV가 정확히 "development"일 때만 /api/sync/childbook/recommendations(무인증 크롤링 트리거)가
# 활성화됩니다. 값이 비어 있거나 다른 값이면 항상 차단되므로, 운영 서버(Lightsail)에서는
# 반드시 ENV=production으로 명시해 두세요.
ENV=production

# QA 백도어 토큰(TEST_QA_TOKEN) 허용 여부. ENV=development일 때도 자동으로 켜지지만,
# 프리뷰/스테이징처럼 ENV는 production인데 QA 로그인만 필요할 때 true로 켭니다.
# 운영 서버에서는 반드시 비워두거나 false로 유지하세요.
ALLOW_QA_MOCK=false

# ─── 관리자 토큰 ──────────────────────────────────────────────────────────────
# Threads 관리자 API 인증 토큰 (임의의 안전한 문자열로 변경 권장)
# 비어 있으면 main.py의 lifespan에서 RuntimeError를 던져 서버(fastapi.service)가 기동에 실패합니다.
THREADS_ADMIN_TOKEN=your-secure-admin-token-here
